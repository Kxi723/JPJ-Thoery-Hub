<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="JPJ_Theory_Hub.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>JPJ Theory Hub - Group 31</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />

    <%--if 'account setting' got bug, use this--%>    
    <%--<link href="~/Content/Site.css" rel="stylesheet" runat="server" />--%>  
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <style type="text/css">
        .auto-style1 {
            font-weight: 700;
            text-align: left;
        }
    </style>

</head>
<body class="kxiBackground">
    <form runat="server" class="d-flex flex-column min-vh-100">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Path="~/Scripts/bootstrap.bundle.js" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>       
        <%--Framework Scripts--%>

        <nav class="navbar navbar-expand-sm " style="background-color: #202020;">
            <div class="container-fluid kxi-navigation-bar-padding flex-grow-1">
                <a class="navbar-brand kxi-text-unhighlightable"">
                    <span class="kxi-logo-20 font-monospace">JPJ Theory Hub</span>
                </a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item mx-4 kxi-text-unhighlightable" ><a class="nav-link" runat="server" href="~/HomePage">
                            <span class="kxi-white-20">Home</span></a></li>
                        <li class="nav-item mx-4 dropdown">
                             <a class="nav-link dropdown-toggle kxi-toggle-white kxi-text-unhighlightable" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="kxi-white-20">Question Bank</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item kxi-text-unhighlightable" runat="server" href="~/RoadSign" style="font-size: 15px">
                                    <span class="fw-semibold">⛔ Road Sign</span></a></li>
                                <li><a class="dropdown-item kxi-text-unhighlightable" runat="server" href="~/RoadScenario" style="font-size: 15px">
                                    <span class="fw-semibold">🚦 Traffic Rule</span></a></li>
                                <li><a class="dropdown-item kxi-text-unhighlightable" runat="server" href="~/Law" style="font-size: 15px">
                                    <span class="fw-semibold">📖 Law</span></a></li>
                            </ul>
                        </li>
                        <li class="nav-item mx-4 dropdown">
                            <a class="nav-link dropdown-toggle kxi-toggle-white kxi-text-unhighlightable" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="kxi-white-20">Quiz</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item kxi-text-unhighlightable" runat="server" href="~/ColourBlindTest" style="font-size: 15px">
                                    <span class="fw-semibold">🏳️‍🌈 Colour Blind Test</span></a></li>
                                <li><a class="dropdown-item kxi-text-unhighlightable" runat="server" href="~/Quiz" style="font-size: 15px">
                                    <span class="fw-semibold">🚗 KPP Test</span></a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item kxi-text-unhighlightable"><a class="nav-link disabled" href="#" title="Logged in as">
                            <asp:Label ID="lblUserName" runat="server" CssClass="kxi-white-20"></asp:Label></a></li>
                        <li class="nav-item kxi-text-unhighlightable""><a class="nav-link" runat="server" href="~/AccountSetting">
                            <span class="kxi-white-20">⚙️ Account</span></a></li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container-fluid kxi-websize-padding">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <footer class="text-white" style="background-color: #202020; padding: 40px 0; margin-top: 200px; min-height: 250px">
            <div class="container-fluid kxi-websize-padding">
                <div class="row">
                        
                    <div class="col-md-4 mb-4">
                        <h5 class="kxi-logo-20 font-monospace">JPJ Theory Hub</h5>
                        <p style="font-size: 0.8rem; color: #888;">
                            &copy; All Rights Reserved 2025
                        </p>
                    </div>

                    <div class="col-md-4 mb-4" style="font-size: 0.9rem;">
                        <h5>Quick Links</h5>
                        <ul class="list-unstyled">
                            <li><a class="nav-link" runat="server" href="~/HomePage" style="padding-left: 0;">🏠 Home</a></li>
                            <li><a class="nav-link" runat="server" href="~/RoadSign" style="padding-left: 0;">⛔ Road Sign</a></li>
                            <li><a class="nav-link" runat="server" href="~/RoadScenario" style="padding-left: 0;">🚦 Traffic Rule</a></li>
                            <li><a class="nav-link" runat="server" href="~/Law" style="padding-left: 0;">📖 Law</a></li>
                            <li><a class="nav-link" runat="server" href="~/ColourBlindTest" style="padding-left: 0;">🏳️‍🌈 Colour Blind Test</a></li>
                            <li><a class="nav-link" runat="server" href="~/Quiz" style="padding-left: 0;">🚗 KPP Test</a></li>
                            <li><a class="nav-link" runat="server" href="~/AccountSetting" style="padding-left: 0;">⚙️ Account</a></li>
                        </ul>
                    </div>

                    <div class="col-md-4 mb-4" style="font-size: 0.9rem;">
                        <h5>Developer Team</h5>
                        <p class="auto-style1" style="margin-bottom: 5px;">Group 31</p>
                        <ul class="list-unstyled" style="font-size: 0.8rem; color: #ccc;">
                            <li>Jason Lai Kwang Xi - TP080522</li>
                            <li>Chong Kah Heng - TP080938</li>
                            <li>Chen Tiansheng - TP073854</li>
                            <li>Lee Yung Cee - TP080674</li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>
    </form>
</body>